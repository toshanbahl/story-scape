# Copy this file to .env and fill in real values. .env is ignored by Git.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=sb_publishable_your-key

# AI captions. Any OpenAI-compatible service.
# Groq (free): console.groq.com
OPENAI_API_KEY=gsk_your-groq-key
OPENAI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-120b
# For OpenAI instead: delete OPENAI_BASE_URL and set AI_MODEL=gpt-4o
